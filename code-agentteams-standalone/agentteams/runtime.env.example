# AgentTeams runtime configuration. Copy values into your shell environment.
# No secret or model API key is required by runtime.mjs/selfcheck.mjs.

AT_WSL_DISTRO=Ubuntu
AT_CONTAINERS=agentteams-controller,agentteams-manager,agentteams-dashboard
AT_MATRIX_URL=http://127.0.0.1:18080/_matrix/client/versions
AT_MANAGER_URL=http://127.0.0.1:18888/
AT_DASHBOARD_URL=http://127.0.0.1:13000/
AT_COMMAND_TIMEOUT_MS=20000
AT_START_TIMEOUT_MS=45000
AT_HTTP_TIMEOUT_MS=5000

# Real three-identity demos read locally provisioned Matrix tokens from this folder.
# Do not commit the token files.
# AT_TOKEN_DIR=C:\Users\you\AppData\Local\Temp\at-tokens

