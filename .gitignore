# OS
Thumbs.db
Desktop.ini
.DS_Store

# 编辑器
.vscode/
.idea/
*.swp

# Node（未来）
node_modules/
dist/
*.log

# Python（未来）
__pycache__/
.venv/
*.pyc

# 本地实验产物
tmp/
*.local.*
benchmark/shadowbench-w/corpus/prompt-ch*.txt

# 实验结果**要进版本库**——results-log.md 里的每个数字都得能被第三方核对，
# 否则基准就只剩一句「相信我」。原先此处整目录排除，等于把唯一的证据挡在门外。
# 只排除两类：可重建的缓存、运行时临时文件。
benchmark/shadowbench-w/results/.embed-cache.json
benchmark/shadowbench-w/results/.run.lock
benchmark/shadowbench-w/results/*.judged.json

# 本象包的写锁——进程持有期间才存在，崩溃残留的会被下一次提交按超时抢占清理。
# 包本身（含 provenance/history.jsonl）**要进版本库**：那是证据链。
*.origin/.origin.lock

# 本机 AI 工具装进来的第三方技能包与其锁文件。属于开发者的工具环境，不是本协议的一部分，
# 且体积以 MB 计（含图片资源）。换一台机器不需要它们也能 npm run verify 全绿。
.agents/
.claude/
skills-lock.json

# 一次性脚本的临时输出
h
# 浏览器自动化留下的 Edge profile（110MB 级，CAD 卡片渲染实验产物，可随时重建）
.tmp-edge-cad-card/

# 凭证
.secrets/
*.key
.vercel
.env*.local
